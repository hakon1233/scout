# Notiva environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic (Claude) — used for ranking (haiku) and brief synthesis (opus).
ANTHROPIC_API_KEY=

# Exa — web search provider for agent news fetch.
EXA_API_KEY=

# Postgres (Neon). Required once persistence lands in PER-4.
DATABASE_URL=

# Auth.js (NextAuth v5). Required once auth lands.
AUTH_SECRET=

# Resend — magic-link email transport. Required once auth lands.
RESEND_API_KEY=
