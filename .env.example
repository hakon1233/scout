# Scout environment variables
#
# NOT REQUIRED for local dev or the live product. Every variable below
# belongs to the quarantined future/supabase/ path (see
# future/supabase/README.md) — a deferred multi-user roadmap item that no
# shipping code (src/ or packages/) imports. Fill these in only if you're
# working on that future path. Copy to .env.local and never commit it.

# --- Public (future/supabase client only — currently unused) ---
# Supabase project URL and anon key. Safe in client because RLS protects rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secrets (future/supabase Edge Functions only, never in the client bundle) ---
# Anthropic (Claude) — Haiku 4.5 for ranking, Opus 4.7 for synthesis.
ANTHROPIC_API_KEY=

# Exa — web search provider for agent news fetch.
EXA_API_KEY=

# Supabase service role — required for server-side inserts from edge functions.
SUPABASE_SERVICE_ROLE_KEY=
