# Notiva environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (ships in the static bundle) ---
# Supabase project URL and anon key. Safe in client because RLS protects rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secrets (Supabase Edge Functions only, never in the client bundle) ---
# Anthropic (Claude) — Haiku 4.5 for ranking, Opus 4.7 for synthesis.
ANTHROPIC_API_KEY=

# Exa — web search provider for agent news fetch.
EXA_API_KEY=

# Supabase service role — required for server-side inserts from edge functions.
SUPABASE_SERVICE_ROLE_KEY=
