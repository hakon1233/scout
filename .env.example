# Scout environment variables
#
# The web app needs no environment variables, and there is no Anthropic or
# web-search key anywhere: the companion (packages/agent) shells out to your
# local `claude` CLI, which authenticates itself.
#
# Everything below is an OPTIONAL companion override. Set them in the shell
# that runs `scout-agent run` (or in its launchd plist), not in .env.local.

# Port the companion binds on 127.0.0.1 (default 47821).
# SCOUT_AGENT_PORT=47821

# Path to the `claude` binary (default: `claude` on PATH).
# SCOUT_CLAUDE_BIN=/usr/local/bin/claude

# Extra browser origins allowed to call the companion, as exact origins,
# comma-separated (for example a `tailscale serve` URL). Loopback and the
# hosted UI are always allowed.
# SCOUT_ALLOWED_ORIGINS=https://my-mac.example-tailnet.ts.net:48721

# Hard ceiling for one `claude` run, in milliseconds (default 240000).
# SCOUT_SESSION_TIMEOUT_MS=240000
