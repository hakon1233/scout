{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "npx serve out",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs && pnpm --filter @scout/agent test && pnpm run test:web",
    "test:web": "tsx --test src/lib/companion.test.ts src/lib/run-history.test.ts src/lib/safe-storage.test.ts src/app/app/page.test.ts",
    "build:agent-webroot": "node scripts/build-agent-webroot.mjs",
    "build:agent": "pnpm run build:agent-webroot && pnpm --filter @scout/agent build",
    "pack:agent": "pnpm run build:agent && mkdir -p public/agent && cd packages/agent && npm pack --pack-destination ../../public/agent",
    "check:tarball-dist": "node scripts/check-tarball-dist.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
