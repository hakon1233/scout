{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "npx serve out",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @scout/agent test && pnpm run test:web",
    "test:web": "tsx --test 'src/**/*.test.ts'",
    "build:agent-webroot": "node scripts/build-agent-webroot.mjs",
    "build:agent": "pnpm run build:agent-webroot && pnpm --filter @scout/agent build",
    "pack:agent": "pnpm run build:agent && mkdir -p public/agent && cd packages/agent && npm pack --pack-destination ../../public/agent",
    "check:tarball-dist": "node scripts/check-tarball-dist.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "@babel/core": "^7.29.6",
      "js-yaml": "^4.2.0",
      "esbuild": ">=0.28.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
