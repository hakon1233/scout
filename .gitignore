# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# companion package build output
/packages/*/dist
/packages/*/node_modules
# bundled Scout web UI, generated by scripts/build-agent-webroot.mjs
/packages/agent/webroot
# companion tarball, repacked from src/ on deploy (pnpm run pack:agent) — never
# commit it, or it drifts from source (PER-113 #3)
/public/agent/*.tgz

# supabase local dev artifacts
/supabase/.branches
/supabase/.temp
